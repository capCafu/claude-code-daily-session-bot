# Telegram credentials.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789

# Your preferred timezone to show times in.
# Example: "America/New_York", "Europe/London", etc.
TIMEZONE=UTC

# Optional: drive several Claude accounts from this one bot.
# Comma-separated names (the first is the primary), or name:configDir pairs.
# Each account needs its own logged-in config dir — see the README.
# Leave unset to run a single account exactly as before.
#CLAUDE_ACCOUNTS=work,personal
#CLAUDE_ACCOUNTS_DIR=/data/accounts
